# Deixe em branco para usar o catálogo local de demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usado somente no servidor para operações administrativas. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredos exclusivos do servidor. Gere a chave com: openssl rand -base64 32
CRON_SECRET=
INTEGRATION_ENCRYPTION_KEY=

# Mercado Livre Developers (OAuth 2.0)
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=http://localhost:3000/api/integrations/mercado-livre/callback
# Opcional somente para desenvolvimento; em produção prefira o OAuth do painel.
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_SYNC_QUERIES=processador,placa mãe,memória DDR5,placa de vídeo,SSD NVMe,fonte ATX,gabinete PC,cooler CPU

# Amazon Creators API. O provider permanece desativado até o conector ser homologado.
AMAZON_CREATORS_API_CREDENTIAL_ID=
AMAZON_CREATORS_API_CREDENTIAL_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br

# Fixtures locais, nunca exibidas como preços reais.
INTEGRATION_MOCK_ENABLED=false
